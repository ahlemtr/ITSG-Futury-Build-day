OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small
DATABASE_URL=postgresql://eel:eel@postgres:5432/eel
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
KG_BACKEND=yaml
SIGNING_KEY_PATH=data/keys/ed25519.pem
DATA_DIR=data

# Starting point: VB 13.3 and Peter only (empty = full seed with 13.3 + 13.4, used by the tests)
SPEC_BASELINE=VB@13.3
SEED_ON_START=0
# Allows the demo reset (user menu) from other machines than localhost. Keep 0 unless needed.
ALLOW_RESET=0
