<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ITSG · Prüfbericht {{ r.submission_id }}</title>
<style>
@font-face { font-family: Report; src: url("{{ font_regular }}") format("woff"); font-weight: 400; }
@font-face { font-family: Report; src: url("{{ font_medium }}") format("woff"); font-weight: 500; }
@font-face { font-family: ReportHeading; src: url("{{ font_heading }}") format("woff"); font-weight: 700; }
@page {
  size: A4; margin: 17mm 16mm 20mm;
  @bottom-left { content: "ITSG · DTA EEL / Prüfbericht"; font: 8pt Report, sans-serif; color: #68717c; }
  @bottom-right { content: "Seite " counter(page) " / " counter(pages); font: 8pt Report, sans-serif; color: #68717c; }
}
* { box-sizing: border-box; }
html { background: #e9edf1; }
body { margin: 0; color: #25303b; font: 10pt/1.55 Report, sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.document { width: 210mm; margin: 28px auto; padding: 17mm 16mm 21mm; background: white; box-shadow: 0 8px 40px #25303b14; }
.letterhead { width: 100%; border-collapse: collapse; border-bottom: 2px solid #d50032; margin-bottom: 10mm; }
.letterhead td { vertical-align: middle; padding: 0 0 6mm; }
.brand-logo { width: 37mm; height: auto; display: block; }
.issuer { text-align: right; color: #68717c; font-size: 8pt; line-height: 1.5; }
.issuer strong { color: #25303b; font-weight: 500; }
h1, h2, h3, p { margin: 0; }
h1, h2, h3 { font-family: ReportHeading, sans-serif; font-weight: 700; line-height: 1.15; }
.eyebrow, .section-number { color: #a8002a; font-size: 8pt; font-weight: 500; letter-spacing: .15em; text-transform: uppercase; }
h1 { font-size: 37pt; letter-spacing: -.02em; margin: 2mm 0 3mm; }
.subtitle { color: #68717c; font-size: 12pt; margin-bottom: 7mm; }
.reference { display: table; width: 100%; border-top: 1px solid #dce1e6; border-bottom: 1px solid #dce1e6; padding: 3mm 0; font-size: 8pt; }
.reference div { display: table-cell; vertical-align: top; width: 50%; }
.reference div:last-child { text-align: right; }
.reference span, .meta-label { display: block; color: #68717c; font-size: 7.5pt; margin-bottom: 1mm; }
.reference strong { font-weight: 500; overflow-wrap: anywhere; }
.result-panel { margin: 7mm 0 6mm; background: #f2f7f4; border-left: 3px solid #247446; padding: 5mm 6mm; break-inside: avoid; }
.result-panel.bug { background: #fff4f2; border-color: #b42318; }
.result-panel.invalid { background: #f6f1fa; border-color: #6b2fa3; }
.result-panel.unclear { background: #fff8ed; border-color: #9a5b00; }
.result-panel.correct_variant { background: #f0f5fc; border-color: #1f5fad; }
.result-label { font-size: 7.5pt; color: #68717c; letter-spacing: .1em; text-transform: uppercase; }
.result-panel h2 { font-size: 23pt; margin: 1.5mm 0 2mm; }
.result-panel p { font-size: 9pt; max-width: 142mm; }
.metrics { display: table; width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 8mm; }
.metric { display: table-cell; width: 33.33%; padding: 0 5mm; border-left: 1px solid #dce1e6; }
.metric:first-child { padding-left: 0; border-left: 0; }
.metric strong { display: block; font: 700 27pt/1.1 ReportHeading, sans-serif; }
.metric span { font-size: 8pt; color: #68717c; }
section { margin-top: 8mm; }
.section-head { display: table; width: 100%; margin-bottom: 4mm; border-bottom: 1px solid #dce1e6; padding-bottom: 2.5mm; break-after: avoid; }
.section-number { display: table-cell; width: 10mm; vertical-align: baseline; }
.section-head h2 { display: table-cell; font-size: 18pt; }
.metadata { width: 100%; border-collapse: collapse; table-layout: fixed; }
.metadata td { width: 50%; vertical-align: top; padding: 0 7mm 4mm 0; overflow-wrap: anywhere; }
.meta-value { font-weight: 500; font-size: 10pt; }
.section-note { font-size: 8.5pt; color: #68717c; margin-bottom: 4mm; }
.chain { padding: 0; margin: 0; list-style: none; }
.chain li { display: inline-block; vertical-align: top; margin: 0 2mm 2mm 0; padding: 2.5mm 3mm; border: 1px solid #dce1e6; background: #f8f9fa; min-width: 19mm; }
.chain small { display: block; color: #68717c; font-size: 7pt; }
.chain strong { font: 700 15pt ReportHeading, sans-serif; }
.outcome-counts { margin: 0 0 4mm; }
.count { display: inline-block; margin: 0 4mm 2mm 0; font-size: 8pt; }
.count strong { font-weight: 500; }
.finding { border: 1px solid #dce1e6; margin: 0 0 5mm; break-inside: avoid; }
.finding-head { width: 100%; border-collapse: collapse; background: #f7f8fa; border-bottom: 1px solid #dce1e6; }
.finding-head td { padding: 3mm 4mm; vertical-align: top; }
.finding-head td:last-child { text-align: right; width: 40mm; }
.finding-index { font: 700 10pt ReportHeading, sans-serif; color: #7c8793; margin-right: 2mm; }
.finding-title { font: 700 13pt ReportHeading, sans-serif; overflow-wrap: anywhere; }
.finding-kind { color: #68717c; font-size: 7.5pt; margin: 1mm 0 0; }
.finding-body { padding: 4mm; }
.label { display: inline-block; padding: 1mm 2mm; font: 500 7.5pt/1.3 Report, sans-serif; white-space: normal; }
.label.exact_match { background: #e6f4ea; color: #1e6b3c; }
.label.correct_variant { background: #e8f0fb; color: #1f5fad; }
.label.bug { background: #fdebe9; color: #a32118; }
.label.invalid { background: #f0e9f9; color: #6b2fa3; }
.label.unclear { background: #fdf1e1; color: #865200; }
.finding-meta { color: #68717c; font-size: 8pt; margin-bottom: 3mm; }
.comparison { width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 3mm; }
.comparison td { width: 50%; padding: 2.5mm 3mm; border: 1px solid #e4e8ec; vertical-align: top; }
.comparison th { text-align: left; color: #68717c; font-size: 7pt; font-weight: 400; padding-bottom: 1mm; }
.comparison .value { font: 8pt/1.5 monospace; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all; }
.explanation { font-size: 9pt; white-space: pre-line; overflow-wrap: anywhere; }
.sources { margin-top: 3mm; font-size: 7.5pt; color: #68717c; overflow-wrap: anywhere; }
.sources strong { color: #25303b; font-weight: 500; }
.passage { border-left: 2px solid #b5c1cd; background: #f7f9fb; margin: 3mm 0 0; padding: 2.5mm 3mm; font-size: 8pt; line-height: 1.5; }
.passage .meta-label { font-size: 7pt; }
.ai-note { margin-top: 3mm; padding-top: 3mm; border-top: 1px dashed #dce1e6; color: #68717c; font-size: 8pt; overflow-wrap: anywhere; }
.empty-state { border: 1px solid #d9e7de; background: #f6faf7; padding: 5mm; font-size: 9pt; }
.file-table { width: 100%; border-collapse: collapse; }
.file-table th { text-align: left; color: #68717c; font-size: 7.5pt; font-weight: 400; border-bottom: 1px solid #dce1e6; padding: 0 0 2mm; }
.file-table td { vertical-align: top; padding: 3mm 4mm 3mm 0; border-bottom: 1px solid #e9edf0; }
.file-table td:first-child { width: 33%; overflow-wrap: anywhere; font-size: 8pt; }
.digest { font: 7pt/1.65 monospace; overflow-wrap: anywhere; word-break: break-all; }
.integrity { break-inside: avoid; }
.signature-state { font-size: 10pt; font-weight: 500; margin-bottom: 1mm; }
.signature-grid { margin: 4mm 0 0; padding: 4mm; border: 1px solid #dce1e6; background: #fafbfc; }
.signature-grid dt { color: #68717c; font-size: 7pt; margin: 0 0 1mm; }
.signature-grid dd { margin: 0 0 3mm; }
.signature-grid dd:last-child { margin-bottom: 0; }
.document-end { margin-top: 8mm; padding-top: 3mm; border-top: 2px solid #d50032; color: #68717c; font-size: 7.5pt; }
.document-end strong { color: #25303b; font-weight: 500; }
@media print {
  html, body { background: white; }
  .document { width: auto; margin: 0; padding: 0; box-shadow: none; }
  .letterhead { margin-bottom: 8mm; }
  h1 { font-size: 34pt; }
}
@media screen and (max-width: 820px) {
  .document { width: 100%; margin: 0; padding: 8vw 6vw; box-shadow: none; }
  h1 { font-size: 31pt; }
  .issuer { font-size: 7pt; }
  .brand-logo { width: 30mm; }
  .metric { padding-right: 2mm; padding-left: 3mm; }
  .metric span { font-size: 7pt; }
  .finding-head td:last-child { width: 30mm; }
}
</style>
</head>
<body>
<main class="document">
  <table class="letterhead" role="presentation"><tr>
    <td><img class="brand-logo" src="{{ logo }}" alt="ITSG" width="140" height="61"></td>
    <td class="issuer"><strong>Informationstechnische Servicestelle<br>der gesetzlichen Krankenversicherung</strong><br>DTA EEL · Prüfplattform</td>
  </tr></table>
  <header>
    <p class="eyebrow">Datenaustausch Entgeltersatzleistungen</p>
    <h1>Prüfbericht</h1><p class="subtitle">Testfall {{ r.test_case_id }}</p>
    <div class="reference"><div><span>Berichtsreferenz / Einreichung</span><strong>{{ r.submission_id }}</strong></div><div><span>Erstellt am</span><strong>{{ display_date(r.created, true) }}</strong></div></div>
  </header>
  <div class="result-panel {{ r.label }}"><div class="result-label">Prüfergebnis</div><h2>{{ outcomes.get(r.label, r.label) }}</h2><p>{{ summaries.get(r.label, "Die Ergebnisse der Prüfung sind in diesem Bericht dokumentiert.") }}</p></div>
  <div class="metrics"><div class="metric"><strong>{{ r.expected_messages }}</strong><span>erwartete Meldungen</span></div><div class="metric"><strong>{{ r.actual_messages }}</strong><span>eingereichte Meldungen</span></div><div class="metric"><strong>{{ r.checks | length }}</strong><span>dokumentierte Feststellungen</span></div></div>
  <section aria-labelledby="scope-title">
    <div class="section-head"><span class="section-number">01</span><h2 id="scope-title">Prüfgegenstand &amp; Regelwerk</h2></div>
    <table class="metadata" role="presentation"><tr><td><span class="meta-label">Hersteller</span><span class="meta-value">{{ r.vendor or "Nicht angegeben" }}</span></td><td><span class="meta-label">Produkt / Kennung</span><span class="meta-value">{{ r.product_id or "Nicht angegeben" }}</span></td></tr><tr><td><span class="meta-label">Verfahrensbeschreibung</span><span class="meta-value">DTA EEL · Version {{ r.rule_set_version }}</span></td><td><span class="meta-label">Prüfstichtag</span><span class="meta-value">{{ display_date(r.valid_on) }}</span></td></tr></table>
  </section>
  {% if r.chain %}<section aria-labelledby="chain-title">
    <div class="section-head"><span class="section-number">02</span><h2 id="chain-title">Erwarteter Meldeverlauf</h2></div><p class="section-note">Reihenfolge der Abgabegründe für den geprüften Testfall.</p>
    <ol class="chain">{% for code in r.chain %}<li><small>Schritt {{ loop.index }}</small><strong>{{ code }}</strong></li>{% endfor %}</ol>
  </section>{% endif %}
  <section aria-labelledby="findings-title">
    <div class="section-head"><span class="section-number">{{ "03" if r.chain else "02" }}</span><h2 id="findings-title">Feststellungen &amp; Begründungen</h2></div>
    {% if r.counts %}<div class="outcome-counts">{% for kind, count in r.counts.items() %}<span class="count"><strong>{{ count }}</strong> {{ outcomes.get(kind, kind) }}</span>{% endfor %}</div>{% endif %}
    {% if r.checks %}{% for c in r.checks %}<article class="finding">
      <table class="finding-head" role="presentation"><tr><td><span class="finding-index">{{ "%02d" | format(loop.index) }}</span><span class="finding-title">{{ c.record }}{% if c.field %}.{{ c.field }}{% endif %}</span><p class="finding-kind">{{ kinds.get(c.kind, c.kind) }}</p></td><td><span class="label {{ c.outcome }}">{{ outcomes.get(c.outcome, c.outcome) }}</span></td></tr></table>
      <div class="finding-body">
        <p class="finding-meta">{% if c.step is not none %}Schritt {{ c.step }}{% endif %}{% if c.abgabegrund %}{% if c.step is not none %} · {% endif %}Abgabegrund {{ c.abgabegrund }}{% endif %}{% if c.rule %} · Regel {{ c.rule }}{% endif %}{% if c.resolved_by %} · Einordnung: {{ c.resolved_by }}{% endif %}</p>
        <table class="comparison"><thead><tr><th>ERWARTETER INHALT</th><th>EINGEREICHTER INHALT</th></tr></thead><tbody><tr><td><div class="value">{{ c.expected if c.expected is not none else "–" }}</div></td><td><div class="value">{{ c.actual if c.actual is not none else "–" }}</div></td></tr></tbody></table>
        <p class="explanation">{{ c.explanation }}</p>
        {% if c.rule or c.criterion or c.sources %}<div class="sources">{% if c.rule %}<strong>Prüfregel</strong> {{ c.rule }}{% endif %}{% if c.criterion %}<br><strong>Prüfkriterium</strong> {{ c.criterion }}{% endif %}{% if c.sources %}<br><strong>Quellen</strong> {{ c.sources | join(" · ") }}{% endif %}</div>{% endif %}
        {% if c.passage and c.outcome in ("bug", "invalid", "unclear") %}<blockquote class="passage"><span class="meta-label">Auszug aus der Prüfgrundlage</span>{{ c.passage[:900] }}{% if c.passage | length > 900 %} …{% endif %}</blockquote>{% endif %}
        {% if c.ai_proposal %}<div class="ai-note"><strong>KI-Vorschlag</strong> {{ c.ai_proposal.proposal }}{% if c.ai_proposal.citations %}<br>Quellen: {{ c.ai_proposal.citations | join(" · ") }}{% endif %}</div>{% endif %}
      </div>
    </article>{% endfor %}{% else %}<p class="empty-state">Alle verglichenen Felder sind identisch. Alle geprüften Regelfelder sind gültig.</p>{% endif %}
  </section>
  <section aria-labelledby="files-title"><div class="section-head"><span class="section-number">{{ "04" if r.chain else "03" }}</span><h2 id="files-title">Eingabedateien</h2></div><p class="section-note">SHA-256-Prüfsummen der Dateien, auf denen dieser Bericht beruht.</p>
    <table class="file-table"><thead><tr><th>Dateiname</th><th>SHA-256</th></tr></thead><tbody>{% for f in r.files %}<tr><td>{{ f.name }}</td><td class="digest">{{ f.sha256 }}</td></tr>{% endfor %}</tbody></table>
  </section>
  {% if sig %}<section class="integrity" aria-labelledby="integrity-title">
    <div class="section-head"><span class="section-number">{{ "05" if r.chain else "04" }}</span><h2 id="integrity-title">Digitale Signatur &amp; Integrität</h2></div><p class="signature-state">Digital signierter Bericht · {{ sig.algorithm }}</p><p class="section-note">Die Signatur schützt die Integrität des maschinenlesbaren Berichts. Zur Verifikation dienen das signierte JSON, die Prüfsumme und der öffentliche Schlüssel.</p>
    <dl class="signature-grid"><dt>SHA-256 des Berichts-JSON</dt><dd class="digest">{{ sig.json_sha256 }}</dd><dt>Digitale Signatur · {{ sig.algorithm }} / Base64</dt><dd class="digest">{{ sig.value }}</dd><dt>Öffentlicher Schlüssel / Base64</dt><dd class="digest">{{ sig.public_key }}</dd></dl>
  </section>{% endif %}
  <footer class="document-end"><strong>ITSG · DTA EEL</strong><br>Prüfbericht {{ r.submission_id }} · Testfall {{ r.test_case_id }} · VB {{ r.rule_set_version }}</footer>
</main>
</body>
</html>
